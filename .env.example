# Local development defaults. Never use these values in production.
MYSQL_DATABASE=duong_an_v11
MYSQL_ROOT_PASSWORD=DuongAnLocalOnly-Change-Me-84!
MYSQL_PORT=3308

# To create the first real admin once, set both variables, start the backend,
# then remove them from .env. No demo accounts are created by default.
# SETUP_ADMIN_EMAIL=
# SETUP_ADMIN_PASSWORD=

# Where uploaded website images/videos are stored. Default: ./uploads/website (relative to the backend working directory).
# In production point this at a persistent volume/disk, otherwise uploads are lost on redeploy.
# WEBSITE_UPLOAD_DIR=

# Enable only with approved data protection conditions; use synthetic data for free-tier tests.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_REQUESTS_PER_USER_HOUR=10
GEMINI_REQUESTS_PER_HOUR=100
